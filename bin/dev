#!/usr/bin/env sh

if ! command -v npm > /dev/null; then
  echo "npm not found. Install Node 22 (see .tool-versions) to build the JavaScript/CSS bundles."
  exit 1
fi

trap "trap - SIGTERM && kill -- -$$" SIGINT SIGTERM EXIT

# Watch the bundles (app/assets/builds) in the background: esbuild for JS,
# dart-sass for CSS.
npm run watch &

# ... and run the Rails server in the foreground.
bin/rails server
