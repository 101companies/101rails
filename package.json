{
  "name": "101rails",
  "private": true,
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node esbuild.config.mjs",
    "build:css": "sass --quiet-deps --load-path=node_modules --style=compressed --no-source-map app/javascript/styles/application.scss:app/assets/builds/application.css",
    "watch": "node esbuild.config.mjs --watch & sass --quiet-deps --load-path=node_modules --watch --style=expanded app/javascript/styles/application.scss:app/assets/builds/application.css"
  },
  "dependencies": {
    "@rails/ujs": "^7.1.3-2",
    "ace-builds": "^1.43.6",
    "bootstrap": "4.6.2",
    "chart.js": "^4.5.0",
    "chartkick": "^5.0.1",
    "esbuild": "^0.25.12",
    "immutability-helper": "^3.1.1",
    "jquery": "^3.7.1",
    "popper.js": "^1.16.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1",
    "react-tagcloud": "^2.3.3"
  },
  "devDependencies": {
    "sass": "^1.108.2"
  }
}
